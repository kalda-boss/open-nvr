+func TestTrackSyncMissingSenderReports(t *testing.T) {
+	// no video sender reports for 8 minutes
+	sim := newTrackSyncCam5Sim(3600)
+	sim.tracks[0].srGap = [2]float64{1200, 1680}
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
+	conv := int(60 / sim.tracks[0].realPeriod)
+	// the trend is extrapolated, so the error stays small (without it, it would grow to 0.8s)
+	require.Less(t, trackSyncMaxAbs(errs[conv:]), 0.06)
+	require.Equal(t, 0, sim.log.warns)
+}
+
+func TestTrackSyncMissingSenderReportsLong(t *testing.T) {
+	// no video sender reports for 30 minutes: the correction stops after 10 minutes of
+	// extrapolation and resumes, gradually, when sender reports come back.
+	sim := newTrackSyncCam5Sim(3 * 3600)
+	sim.tracks[0].srGap = [2]float64{1200, 3000}
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
+	// the skew between tracks never exceeds what the recorder tolerates
+	require.Less(t, trackSyncMaxAbs(errs[int(60/sim.tracks[0].realPeriod):]), 0.6)
+	// and it is recovered at the end
+	require.Less(t, trackSyncMaxAbs(errs[len(errs)-int(600/sim.tracks[0].realPeriod):]), 0.03)
+}
+
+func TestTrackSyncCameraClockStep(t *testing.T) {
+	// the camera clock steps forward by one hour (i.e. NTP synchronization).
+	// Video sender reports see the step 2.5s before audio ones.
+	sim := newTrackSyncCam5Sim(3600)
+	step := func(sent float64) float64 {
+		if sent >= 1800 {
+			return 3600
+		}
+		return 0
+	}
+	sim.tracks[0].srNTPOffset = step
+	sim.tracks[1].srNTPOffset = step
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
+	requireSynced(t, sim, errs)
+	require.Equal(t, 0, sim.log.warns)
+}
+
+func TestTrackSyncSingleTrackJump(t *testing.T) {
+	// sender reports of the video track jump by 2s and stay there (broken camera).
+	// The tracks must never be skewed more than what the recorder tolerates.
+	sim := newTrackSyncCam5Sim(3600)
+	sim.tracks[0].srNTPOffset = func(sent float64) float64 {
+		if sent >= 1800 {
+			return 2
+		}
+		return 0
+	}
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
+	conv := int(60 / sim.tracks[0].realPeriod)
+	require.Less(t, trackSyncMaxAbs(errs[conv:]), trackSyncMaxArrivalSkew.Seconds()+0.15)
+	require.Equal(t, 1, sim.log.warns)
+}
+
+func TestTrackSyncLargeDeclaredSkew(t *testing.T) {
+	// sender reports declare that video is captured 3s before audio, while packets arrive together.
+	// Delivery skew must stay below what the recorder tolerates.
+	sim := newTrackSyncCam5Sim(1800)
+	sim.tracks[0].srNTPOffset = func(float64) float64 { return -3 }
+	sim.run(t)
+
+	requireMonotonic(t, sim.tracks[0])
+
+	tr := sim.tracks[0]
+	ref := sim.tracks[1]
+	r0 := ref.pts[0]
+	for _, o := range tr.pts[int(60/tr.realPeriod):] {
+		refOut := float64(r0.outPTS)/16000 + (o.arrival - r0.arrival)
+		require.Less(t, math.Abs(float64(o.outPTS)/90000-refOut), 1.0)
+	}
+}
