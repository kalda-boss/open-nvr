+// sync error after convergence: under 50ms after one minute, under 30ms after ten minutes
+// (sender reports have +-30ms of noise).
+func requireSynced(t *testing.T, sim *trackSyncSim, errs []float64) {
+	p := sim.tracks[0].realPeriod
+	require.Less(t, trackSyncMaxAbs(errs[int(60/p):]), 0.05)
+	require.Less(t, trackSyncMaxAbs(errs[int(600/p):]), 0.03)
+}
+
+func requireMonotonic(t *testing.T, tr *trackSyncSimTrack) {
+	for i := 1; i < len(tr.pts); i++ {
+		dRaw := tr.pts[i].rawPTS - tr.pts[i-1].rawPTS
+		dOut := tr.pts[i].outPTS - tr.pts[i-1].outPTS
+		if dRaw > 0 {
+			require.Greater(t, dOut, int64(0), "unit %d", i)
+		} else if dRaw < 0 {
+			require.Less(t, dOut, int64(0), "unit %d", i)
+		}
+		// correction never changes by more than 10% of the media time elapsed (+1 tick rounding)
+		require.LessOrEqual(t, math.Abs(float64(dOut-dRaw)), math.Abs(float64(dRaw))/10+1, "unit %d", i)
+	}
+}
+
+func requireUnchanged(t *testing.T, tr *trackSyncSimTrack) {
+	for _, o := range tr.pts {
+		require.Equal(t, o.rawPTS, o.outPTS)
+	}
+}
+
+func TestTrackSyncTicks(t *testing.T) {
+	for _, v := range []int64{0, 1, 89999, 90000, 1234567890123, -90001} {
+		d := trackSyncTicksToDuration(v, 90000)
+		require.InDelta(t, v, trackSyncDurationToTicks(d, 90000), 1)
+	}
+	// no overflow after a long time
+	require.Equal(t, 30*24*time.Hour, trackSyncTicksToDuration(90000*3600*24*30, 90000))
+}
+
+func TestTrackSyncSlowVideo(t *testing.T) {
+	sim := newTrackSyncCam5Sim(2 * 3600)
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
+
+	// without synchronization, video would lag by 1663 ppm * 2h = 12s
+	last := sim.tracks[0].pts[len(sim.tracks[0].pts)-1]
+	require.Greater(t, math.Abs(float64(last.outPTS-last.rawPTS)/90000), 11.0)
+
+	// after convergence, video is aligned with audio
+	requireSynced(t, sim, errs)
+
+	// before the first sender report, timestamps are the ones of the RTP time decoder
+	require.Equal(t, sim.tracks[0].pts[0].rawPTS, sim.tracks[0].pts[0].outPTS)
+	require.Equal(t, 0, sim.log.warns)
+	require.Equal(t, 1, sim.log.infos)
+}
+
+func TestTrackSyncFastVideoWithWraparound(t *testing.T) {
+	sim := newTrackSyncCam1Sim(2 * 3600)
+	sim.run(t)
+
+	requireUnchanged(t, sim.tracks[1])
+	requireMonotonic(t, sim.tracks[0])
+
+	errs := sim.syncErrors(0, 1)
