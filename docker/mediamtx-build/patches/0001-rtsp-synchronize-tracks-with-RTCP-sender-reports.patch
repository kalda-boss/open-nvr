+func newTrackSyncCam5Sim(duration float64) *trackSyncSim {
+	return &trackSyncSim{
+		duration: duration,
+		camEpoch: time.Date(2011, 12, 3, 0, 0, 0, 0, time.UTC),
+		seed:     1,
+		tracks: []*trackSyncSimTrack{
+			{ // H265, 10fps, stamped 9000 ticks per frame, encoded at 9.9834fps (-1663 ppm)
+				forma:      &format.H265{PayloadTyp: 96},
+				mediaType:  description.MediaTypeVideo,
+				clockRate:  90000,
+				ticks:      9000,
+				realPeriod: 0.1 / (1 - 1663e-6),
+				latency:    0.06,
+				jitter:     0.15,
+				tsBase:     4164816704,
+				srOffset:   1.2,
+			},
+			{ // AAC 16kHz, exact clock
+				forma: &format.MPEG4Audio{
+					PayloadTyp: 97,
+					Config: &mpeg4audio.AudioSpecificConfig{
+						Type:         mpeg4audio.ObjectTypeAACLC,
+						SampleRate:   16000,
+						ChannelCount: 1,
+					},
+				},
+				mediaType:  description.MediaTypeAudio,
+				clockRate:  16000,
+				ticks:      1024,
+				realPeriod: 1024.0 / 16000,
+				latency:    0.04,
+				jitter:     0.02,
+				tsBase:     1506459648,
+				srOffset:   3.7,
+			},
+		},
+	}
+}
+
+func newTrackSyncCam1Sim(duration float64) *trackSyncSim {
+	return &trackSyncSim{
+		duration: duration,
+		camEpoch: time.Date(2011, 12, 3, 0, 0, 0, 0, time.UTC),
+		seed:     2,
+		tracks: []*trackSyncSimTrack{
+			{ // H265, 25fps, stamped 3600 ticks per frame, encoded at 25.0202fps (+809 ppm)
+				forma:      &format.H265{PayloadTyp: 108},
+				mediaType:  description.MediaTypeVideo,
+				clockRate:  90000,
+				ticks:      3600,
+				realPeriod: 0.04 / (1 + 809e-6),
+				latency:    0.03,
+				jitter:     0.08,
+				tsBase:     4294967295 - 90000*30, // wraps after 30s
+				srOffset:   0.4,
+			},
+			{ // G711, 64ms packets, exact clock
+				forma:      &format.G711{PayloadTyp: 0, MULaw: true, SampleRate: 8000, ChannelCount: 1},
+				mediaType:  description.MediaTypeAudio,
+				clockRate:  8000,
+				ticks:      512,
+				realPeriod: 512.0 / 8000,
+				latency:    0.03,
+				jitter:     0.02,
+				tsBase:     103768184,
+				srOffset:   2.9,
+			},
+		},
+	}
+}
